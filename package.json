{
  "name": "tibportal",
  "version": "0.4.4",
  "description": "Run several TibIdle sessions side by side, each with its own saved login.",
  "main": "src/main.js",
  "author": "jgriff23",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "productName": "TibPortal",
  "build": {
    "appId": "com.tibportal.app",
    "productName": "TibPortal",
    "copyright": "Copyright \u00a9 2026 jgriff23",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TibPortal",
      "artifactName": "TibPortal-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TibPortal-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jgriff23",
        "repo": "TibPortal",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
